# ML inference API — copy to .env on Server 2
ML_API_HOST=0.0.0.0
ML_API_PORT=8100
ML_LIVE_STREAM_FPS=30
# Live MJPEG output: 0 = native camera resolution (4K passthrough). Set 3840/2160 to cap.
ML_LIVE_MAX_WIDTH=0
ML_LIVE_MAX_HEIGHT=0
ML_LIVE_JPEG_QUALITY=92
# RTSP decode: ffmpeg (required for NVDEC) or opencv (legacy)
ML_RTSP_DECODE=ffmpeg
# NVIDIA NVDEC: true (default) or false to force CPU decode
ML_RTSP_NVDEC=false
# Live AI/view: scale inside FFmpeg to 1080p (NVR keeps original recording)
ML_RTSP_SCALE_WIDTH=1280
ML_RTSP_SCALE_HEIGHT=720
ML_RTSP_FRAME_BUFFER_SIZE=1
ML_RTSP_NVDEC_HW_FRAMES=2
# RTSP resilience (backoff + quarantine stops FFmpeg churn on bad channels)
ML_RTSP_MAX_FAILS=60
ML_RTSP_RECONNECT_SEC=8
ML_RTSP_OPEN_RETRY_SEC=12
ML_RTSP_RECONNECT_MIN_INTERVAL=1.0
ML_RTSP_BACKOFF_MAX_SEC=60
ML_RTSP_QUARANTINE_AFTER=3
ML_LIVE_MAX_CAMERAS=20
# ffmpeg path (optional; auto-detects tools/ffmpeg/bin or PATH)
# FFMPEG_PATH=
ML_DEVICE=0
# GPU: 0 or cuda:0 (default). Set cpu to force CPU-only inference.
ML_YOLO_WEIGHTS=runs/train/stage3_finetune3/weights/yolo26l.pt
ML_YOLO_CUSTOM_WEIGHTS=runs/train/stage3_finetune3/weights/best.pt
ML_YOLO_SMOKE_WEIGHTS=runs/train/stage3_finetune3/weights/best_Smoke_Detection.pt
ML_YOLO_WEAPON_WEIGHTS=runs/train/stage3_finetune3/weights/best_weapon_detection.pt
ML_PLATE_WEIGHTS=runs/train/stage3_finetune3/weights/best_number_plate_detection.pt
ML_YOLO_CONF=0.30
ML_YOLO_IMGSZ=640
ML_YOLO_MAX_DET=200
ML_COCO_MAX_CLASS_ID=79
# COCO detections are filtered to: person, car, truck, bus, motorcycle, backpack,
# handbag, suitcase, cell phone, laptop, knife, bicycle, bench, chair, dining table, bottle.
# Fire/smoke: best_Smoke_Detection.pt | Weapons: best_weapon_detection.pt
ML_SMOKE_FIRE_CONF=0.42
ML_WEAPON_CONF=0.40
# License plate (ANPR) — YOLO plate model + PaddleOCR PP-OCRv5 (GPU)
# ML_PADDLE_OCR_VERSION=PP-OCRv5
# ML_PADDLE_OCR_LANG=en
# ML_PADDLE_DET_MODEL=PP-OCRv5_server_det
# ML_PADDLE_REC_MODEL=en_PP-OCRv5_mobile_rec
# Saves under backend/media/licence plates/ (plates/, frames/, captures.csv)
# ML_MEDIA_ROOT=../backend/media
# ML_PLATE_MEDIA_DIR=
ML_PLATE_CONF=0.25
ML_PLATE_MIN_OCR_CONF=0.25
ML_PLATE_MIN_DET_CONF=0.20
ML_PLATE_MIN_LEN=4
ML_PLATE_SAVE_INTERVAL=8
ML_PLATE_OCR_EVERY=1
ML_PLATE_IMGSZ=1280
# false = only cameras with purpose=anpr; true = all live cameras
ML_PLATE_ON_ALL=false
# Ignore camera OSD/time — only accept plates near a vehicle
ML_PLATE_REQUIRE_VEHICLE=true
ML_PLATE_VEHICLE_IOU=0.02
ML_PLATE_VEHICLE_EXPAND=0.35
# Drop detections in CCTV date/time OSD bands
ML_OSD_FILTER=true
ML_OSD_TOP=0.22
ML_OSD_LEFT=0.55
ML_OSD_RIGHT=0.55
ML_OSD_BOTTOM=0.0
